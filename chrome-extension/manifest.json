{
  "manifest_version": 3,
  "name": "LC Notes – LeetCode to GitHub",
  "version": "1.0.0",
  "description": "One click: create a Markdown note from any LeetCode problem and push it to your GitHub repo.",

  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://api.github.com/*"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "LC Notes"
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
